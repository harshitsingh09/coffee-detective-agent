# Select gemini (default), groq, openai, or rules. Missing keys fall back to rules.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Agent execution is opt-in and remains bounded for public-demo safety.
ENABLE_AI_AGENT=true
MAX_AGENT_STEPS=5
MAX_LOG_RESULTS=20
SIMILAR_INCIDENT_TOP_K=3
SIMILARITY_THRESHOLD=0.35
LLM_TIMEOUT_SECONDS=30

# Local semantic retrieval. The index is persisted and model files stay in .cache/.
EMBEDDING_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1
INCIDENT_EMBEDDING_INDEX_PATH=data/incident_embeddings.json
EMBEDDING_CACHE_PATH=.cache/sentence_transformers

# Paths may be absolute or relative to the project root.
INCIDENT_DATABASE_PATH=data/support.db
INCIDENT_LOG_PATH=data/app_logs.txt
